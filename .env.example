# Supabase Configuration (Client-side)
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Note: Use your project's public anon / publishable key (never the service_role key)
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key

# Optional public key for worldwide place autocomplete (curated Mumbai suggestions work without it).
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Email credentials are not frontend environment variables.
# Add BREVO_API_KEY, BREVO_SENDER_EMAIL, BREVO_SENDER_NAME, and REMINDER_CRON_SECRET
# as Supabase Edge Function secrets after deploying supabase/functions/event-email.
