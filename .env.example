
# Supabase Configuration (Client-side)
# Obtain these from Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key

# Brevo Transactional Email (Server-side only)
BREVO_MOCK_MODE=true
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=notifications@gather.app
BREVO_SENDER_NAME="Gather Events"

# Geoapify Geocoding & Places Autocomplete
# Add your actual key to your local .env file, NOT this file.
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
