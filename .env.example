# Supabase Configuration (Client-side)
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Note: Use your project's public anon / publishable key (never the service_role key)
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key

# Brevo Transactional Email Configuration (Server-Side Only - never prefix with VITE_)
# Set to 'true' to mock all email sends locally (no Brevo account needed).
# Defaults to true when BREVO_API_KEY is unset.
BREVO_MOCK_MODE=true

# Required only when BREVO_MOCK_MODE=false:
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=notifications@gather.app
BREVO_SENDER_NAME="Gather Events"
